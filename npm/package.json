{
  "name": "@tty-pt/islet",
  "version": "1.6.2",
  "type": "module",
  "description": "Universal Node.js and Browser bindings for libislet Spatial Indexing & Morton Z-Order Curves",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prebuilds",
    "include",
    "assets",
    "*.pc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "mkdir -p build/Release && gcc -O3 -fPIC -shared -I/usr/include/node -I../include -I../../libcorm/include native/islet_napi.c -L../lib -L../../libcorm/lib -Wl,-rpath,\\$ORIGIN/../../../lib:\\$ORIGIN/../../../../libcorm/lib -L/usr/lib -lislet -lcorm -o build/Release/islet_node.node",
    "build:wasm": "make -C .. wasm",
    "build": "npm run build:native && npm run build:wasm",
    "test": "node --test tests/islet.test.mjs"
  },
  "peerDependencies": {
    "@tty-pt/corm": ">=2.4.0",
    "@tty-pt/stele": ">=1.7.0"
  },
  "devDependencies": {
    "@tty-pt/corm": "^2.4.0",
    "@tty-pt/stele": "^1.7.0"
  },
  "keywords": [
    "islet",
    "libislet",
    "spatial",
    "morton",
    "z-order",
    "quadtree",
    "2d",
    "3d",
    "gis"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-pt/libislet.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tty-pt/libislet/tree/main/npm#readme",
  "bugs": {
    "url": "https://github.com/tty-pt/libislet/issues"
  }
}
